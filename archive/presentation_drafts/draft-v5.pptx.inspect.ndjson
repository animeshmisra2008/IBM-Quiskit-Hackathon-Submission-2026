{"kind":"textbox","id":"sh/0na1knid","slideIndex":1,"position":{"left":68,"top":178,"width":1090,"height":65},"text":"A qubit stores quantum information. A gate changes it. Noise makes gates imperfect.","geometry":"rect","lineWidth":0,"style":{"fontSize":26.97,"typeface":"Arial","color":"#161616","bold":true,"alignment":"left"}}
