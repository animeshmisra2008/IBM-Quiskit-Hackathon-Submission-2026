{"kind":"textbox","id":"sh/grads32x","slideIndex":3,"position":{"left":390,"top":184,"width":780,"height":46},"text":"Use a known, simulated calibration model for this local experiment.","geometry":"rect","lineWidth":0,"style":{"fontSize":22,"typeface":"Arial","color":"#161616","alignment":"left"}}
{"kind":"textbox","id":"sh/hsje18j2","slideIndex":3,"position":{"left":72,"top":253,"width":320,"height":36},"text":"2  Focus the work","geometry":"rect","lineWidth":0,"style":{"fontSize":25,"typeface":"Arial","color":"#009D9A","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/u5svqtkr","slideIndex":3,"position":{"left":390,"top":253,"width":780,"height":46},"text":"SLC ranks errors by how much they can affect the chosen measurement.","geometry":"rect","lineWidth":0,"style":{"fontSize":22,"typeface":"Arial","color":"#161616","alignment":"left"}}
{"kind":"textbox","id":"sh/vq1wzy1c","slideIndex":3,"position":{"left":72,"top":322,"width":320,"height":36},"text":"3  Correct the result","geometry":"rect","lineWidth":0,"style":{"fontSize":25,"typeface":"Arial","color":"#8A3FFC","bold":true,"alignment":"left"}}
