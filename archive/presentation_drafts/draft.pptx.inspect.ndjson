{"kind":"textbox","id":"sh/r69onu9g","slideIndex":1,"position":{"left":72,"top":338,"width":276,"height":70},"text":"The quantum version of a bit.","geometry":"rect","lineWidth":0,"style":{"fontSize":23,"typeface":"Arial","color":"#161616","alignment":"left"}}
