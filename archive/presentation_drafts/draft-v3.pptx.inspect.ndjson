{"kind":"textbox","id":"sh/kfaxo3ip","slideIndex":3,"position":{"left":390,"top":253,"width":780,"height":46},"text":"SLC ranks errors by how much they can affect the chosen measurement.","geometry":"rect","lineWidth":0,"style":{"fontSize":22,"typeface":"Arial","color":"#161616","alignment":"left"}}
{"kind":"textbox","id":"sh/5g3ex8ja","slideIndex":3,"position":{"left":72,"top":322,"width":320,"height":36},"text":"3  Correct the result","geometry":"rect","lineWidth":0,"style":{"fontSize":25,"typeface":"Arial","color":"#8A3FFC","bold":true,"alignment":"left"}}
