{"kind":"textbox","id":"sh/zix8nitw","slideIndex":7,"position":{"left":72,"top":234,"width":1020,"height":60},"text":"It moved the measured value closer to the ideal result at all three noise levels.","geometry":"rect","lineWidth":0,"style":{"fontSize":24,"typeface":"Arial","color":"#161616","alignment":"left"}}
